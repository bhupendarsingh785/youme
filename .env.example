# Isko .env me copy karo (.env git me kabhi commit nahi hota).
# Ye file process me khud load nahi hoti — hosting ke "Environment variables" me daalo,
# ya chalate waqt:  node --env-file=.env server/index.js

# Zaroori (production me). Banane ke liye:  openssl rand -hex 32
JWT_SECRET=

PORT=3000
DB_PATH=data/youme.db

# Sirf us site ka naam jahan se frontend khulega, jaise https://youme.example.com  (* = sab)
CORS_ORIGIN=*

# 1 tab karo jab server proxy/load balancer ke peeche ho (taaki rate limit asli IP dekhe)
TRUST_PROXY=0

# 1 karo jab site https par ho (browser ko hamesha https par rakhta hai)
HSTS=0

# Apne aap backup: folder do to har BACKUP_EVERY_HOURS ghante me copy banegi, aakhri BACKUP_KEEP rakhi jayengi
BACKUP_DIR=
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=7
